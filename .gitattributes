# Generated art is bytes — never diff it, never mangle its line endings.
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary

# Everything textual is LF in the index, on every platform, so a checkout on
# any machine produces byte-identical files and CI's reproducibility check
# compares like with like.
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
Makefile text eol=lf
LICENSE  text eol=lf
